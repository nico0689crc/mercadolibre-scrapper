# Puertos publicados por docker compose (elegidos para no chocar con el stack assetfy)
FRONTEND_PORT=3100
BACKEND_PORT=4100

# Tunel ngrok de desarrollo (perfil "tunnel"): apunta al backend
NGROK_DOMAIN=glaring-curtsy-veneering.ngrok-free.dev
NGROK_AUTHTOKEN=

# Postgres (5433 lo ocupa el stack assetfy)
POSTGRES_PORT=5434
POSTGRES_USER=scrapper
POSTGRES_PASSWORD=scrapper
POSTGRES_DB=scrapper
