# App
NODE_ENV=development
PORT=4100
FRONTEND_URL=http://localhost:3100

# URL publica del backend (tunel ngrok de desarrollo). Mercado Libre exige HTTPS
# para el redirect de OAuth y para las notificaciones/webhooks.
PUBLIC_URL=https://glaring-curtsy-veneering.ngrok-free.dev

# Mercado Libre — credenciales de la app (https://developers.mercadolibre.com.ar/devcenter)
# El redirect URI debe estar cargado identico en el DevCenter.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://glaring-curtsy-veneering.ngrok-free.dev/api/auth/mercadolibre/callback

# Sitio y dominio de auth (MLA=Argentina, MLB=Brasil, MLM=Mexico, MLU=Uruguay, MLC=Chile)
ML_SITE_ID=MLA
ML_AUTH_DOMAIN=https://auth.mercadolibre.com.ar
ML_API_URL=https://api.mercadolibre.com

# Base de datos (fuera de Docker el host es localhost:5434; compose lo pisa con postgres:5432)
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=scrapper
DATABASE_PASSWORD=scrapper
DATABASE_NAME=scrapper
